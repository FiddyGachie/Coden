{
  "name": "coden-vscode",
  "displayName": "Coden",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/extension.js",
  "engines": { "vscode": "^1.95.0" },
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "commands": [
      { "command": "warden.openMissionControl", "title": "Warden: Open Mission Control" },
      { "command": "warden.showVerdict",         "title": "Warden: Show Verdict" },
      { "command": "warden.restartCore",          "title": "Warden: Restart Core" }
    ]
  },
  "scripts": { "build": "pnpm --filter @warden/core build && pnpm --filter @coden/dashboard build && tsc -p tsconfig.json", "typecheck": "tsc --noEmit -p tsconfig.json", "lint": "tsc --noEmit -p tsconfig.json", "test": "vitest run" },
  "devDependencies": { "@types/vscode": "^1.95.0", "typescript": "^5.8.3", "vitest": "^3.1.4" }
}
